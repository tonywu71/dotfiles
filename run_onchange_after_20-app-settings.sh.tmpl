{{ if and (eq .chezmoi.os "darwin") (index . "personal" | default false) -}}
#!/bin/bash
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf"
if [[ -L "$config" ]]; then
    echo "Configure the btop theme in the source of the symlink: $config" >&2
    exit 1
fi
mkdir -p "$(dirname "$config")"
temporary=$(mktemp "$(dirname "$config")/btop.conf.XXXXXX")
trap 'rm -f "$temporary"' EXIT
input=/dev/null
if [[ -f "$config" ]]; then
    input="$config"
fi
awk '
    /^[[:space:]]*color_theme[[:space:]]*=/ {
        if (!found) print "color_theme = \"dracula\""
        found = 1
        next
    }
    { print }
    END { if (!found) print "color_theme = \"dracula\"" }
' "$input" > "$temporary"
mv "$temporary" "$config"

defaults write com.googlecode.iterm2 CopySelection -bool false
echo 'Quit and reopen iTerm2 to load its selection setting.'
{{ end -}}
