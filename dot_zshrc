if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

[[ ! -d "$HOME/.docker/completions" ]] || fpath=("$HOME/.docker/completions" $fpath)

export ZSH="$HOME/.oh-my-zsh"
# Empty: powerlevel10k draws the prompt below.
ZSH_THEME=""
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 13
zstyle ':omz:update' cooldown 7
plugins=(git)
[[ ! -f "$ZSH/oh-my-zsh.sh" ]] || source "$ZSH/oh-my-zsh.sh"

if command -v brew >/dev/null; then
    brew_prefix=$(brew --prefix)
    if [[ -f "$brew_prefix/share/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
        source "$brew_prefix/share/powerlevel10k/powerlevel10k.zsh-theme"
    fi
    [[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"
fi
if command -v fzf >/dev/null; then
    source <(fzf --zsh)
fi

for file in "$HOME"/.{path,exports,aliases,extra}; do
    [[ ! -f "$file" || ! -r "$file" ]] || source "$file"
done
unset file

if [[ -n ${brew_prefix:-} ]]; then
    if [[ -f "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
        source "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi
    unset brew_prefix
fi

# inshellisense must stay last (see its README).
inshellisense_init="${XDG_DATA_HOME:-$HOME/.local/share}/inshellisense/init/zsh/init.zsh"
[[ -f "$inshellisense_init" ]] && source "$inshellisense_init"
unset inshellisense_init
